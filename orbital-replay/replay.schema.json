{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbital-replay:v1",
  "title": "Orbital replay/v1",
  "description": "Structural validation; src/replay.mjs additionally checks IDs, provenance compatibility, timeline ordering and domain constraints.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "orbital-replay/v1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "mode": {
      "enum": [
        "replay",
        "illustrative"
      ]
    },
    "duration_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "maxItems": 100
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "maxItems": 1000
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      },
      "maxItems": 4000
    },
    "requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/request"
      },
      "maxItems": 5000
    },
    "ground_traces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ground"
      },
      "maxItems": 100
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "maxItems": 50000
    }
  },
  "required": [
    "schema",
    "title",
    "mode",
    "duration_s",
    "provenance",
    "nodes",
    "links",
    "requests",
    "ground_traces",
    "events"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "simulated_positions",
            "assumed_network",
            "measured_ground_trace",
            "recorded_transport",
            "recorded_inference",
            "illustrative"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "description"
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "t_s": {
          "type": "number",
          "minimum": 0
        },
        "rtn_m": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "t_s",
        "rtn_m"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "position_source": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/position"
          },
          "maxItems": 20000
        }
      },
      "required": [
        "id",
        "label",
        "position_source",
        "positions"
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "t_s": {
          "type": "number",
          "minimum": 0
        },
        "bandwidth_bps": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "delay_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "queue_bytes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "t_s"
      ]
    },
    "groundSample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "t_s": {
          "type": "number",
          "minimum": 0
        },
        "bandwidth_bps": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "delay_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "queue_bytes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "loss_fraction": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sent_packets": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "lost_packets": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "t_s"
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "src": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "dst": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sample"
          },
          "maxItems": 20000
        }
      },
      "required": [
        "id",
        "src",
        "dst",
        "source",
        "samples"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttft_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "tpot_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": []
    },
    "requestEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "t_s": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "required": [
        "t_s",
        "status",
        "detail"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "transport",
            "inference"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "src": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "dst": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "route": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          },
          "maxItems": 100
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requestEvent"
          },
          "maxItems": 20000
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "metrics_at_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "src",
        "dst",
        "route",
        "size_bytes",
        "events",
        "metrics",
        "metrics_at_s"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "transport"
              }
            }
          },
          "then": {
            "properties": {
              "metrics": {
                "properties": {
                  "ttft_ms": {
                    "type": "null"
                  },
                  "tpot_ms": {
                    "type": "null"
                  },
                  "tokens": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metrics": {
                "anyOf": [
                  {
                    "required": [
                      "ttft_ms"
                    ],
                    "properties": {
                      "ttft_ms": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  },
                  {
                    "required": [
                      "tpot_ms"
                    ],
                    "properties": {
                      "tpot_ms": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  },
                  {
                    "required": [
                      "tokens"
                    ],
                    "properties": {
                      "tokens": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                ]
              }
            }
          },
          "then": {
            "properties": {
              "metrics_at_s": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "ground": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "rate_semantics": {
          "enum": [
            "service_opportunities",
            "achieved_receive_rate",
            "unavailable"
          ]
        },
        "delay_semantics": {
          "enum": [
            "emulator_input",
            "measured_owd",
            "unavailable"
          ]
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/groundSample"
          },
          "maxItems": 20000
        }
      },
      "required": [
        "id",
        "label",
        "source",
        "rate_semantics",
        "delay_semantics",
        "samples"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "rate_semantics": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "samples": {
                "items": {
                  "properties": {
                    "bandwidth_bps": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "delay_semantics": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "samples": {
                "items": {
                  "properties": {
                    "delay_ms": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "t_s": {
          "type": "number",
          "minimum": 0
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "required": [
        "t_s",
        "label",
        "source"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "illustrative"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "mode": {
            "const": "illustrative"
          }
        }
      }
    }
  ]
}
